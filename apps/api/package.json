{
  "name": "@sigmaos/api",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "types": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --external better-sqlite3 --out-dir dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@sigmaos/db": "0.1.0",
    "@sigmaos/nas-tools": "0.1.0",
    "@sigmaos/shared": "0.1.0",
    "fastify": "^5.5.0"
  }
}

#!/bin/sh
set -e

if [ "$1" = "remove" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl stop sigmaos-api.service 'sigmaos-worker@*.service' sigmaos-indexer.service sigmaos-scheduler.service sigmaos-maintenance.service 2>/dev/null || true
  systemctl disable sigmaos-api.service sigmaos-worker@1.service sigmaos-indexer.timer sigmaos-scheduler.timer sigmaos-maintenance.timer 2>/dev/null || true
fi

#DEBHELPER#

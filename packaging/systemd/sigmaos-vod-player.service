[Unit]
Description=SigmaOS VOD Player
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target systemd-tmpfiles-setup.service sigmaos-api.service
Wants=sigmaos-api.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=20s
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
Environment=HOME=/var/lib/sigmaos-vod-player
WorkingDirectory=/var/lib/sigmaos-vod-player
ExecStart=/usr/lib/sigmaos/bin/sigmaos-vod-player
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
KillMode=control-group
StateDirectory=sigmaos-vod-player
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/nas
ReadWritePaths=/run/sigmaos /var/lib/sigmaos-vod-player
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target

[Unit]
Description=SigmaOS Photostaff media worker
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target sigmaos-api.service
Wants=sigmaos-api.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=20s
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/lib/sigmaos/bin/sigmaos-photostaff
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
KillMode=control-group
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/srv/nas
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
MemoryMax=1G
CPUQuota=250%
TasksMax=256

[Install]
WantedBy=multi-user.target

[Unit]
Description=SigmaOS Rust terminal daemon
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target systemd-tmpfiles-setup.service
Wants=local-fs.target

[Service]
Type=simple
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_TERMUX_USER=sigmaos
Environment=SIGMAOS_TERMUX_SOCKET_PATH=/run/sigmaos/termux.sock
Environment=SIGMAOS_TERMUX_SESSION_IDLE_TIMEOUT_MS=1800000
Environment=SIGMAOS_TERMUX_CONNECT_TIMEOUT_MS=10000
Environment=SIGMAOS_TERMUX_MAX_SESSIONS=32
Environment=HOME=/var/lib/sigmaos-termux
WorkingDirectory=/var/lib/sigmaos-termux
KillMode=process
ExecStart=/usr/lib/sigmaos/bin/sigmaos-termux
Restart=on-failure
RestartSec=3
UMask=0007
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/run/sigmaos /srv/nas /var/lib/sigmaos-termux
InaccessiblePaths=/etc/sigmaos /var/lib/sigmaos /var/log/sigmaos
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target

[Unit]
Description=SigmaOS HTTP downloader
Documentation=file:///usr/share/doc/sigmaos/README.md
After=network-online.target local-fs.target sigmaos-api.service
Wants=network-online.target
Requires=sigmaos-api.service
RequiresMountsFor=/srv/nas

[Service]
Type=simple
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/lib/sigmaos/bin/sigmaos-downloader
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos /srv/nas
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target

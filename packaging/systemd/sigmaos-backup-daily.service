[Unit]
Description=SigmaOS daily restic backup
After=local-fs.target
RequiresMountsFor=/srv/nas /srv/backup

[Service]
Type=oneshot
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
Environment=SIGMAOS_BACKUP_PASSWORD_FILE=%d/restic-password
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
LoadCredential=restic-password:/etc/sigmaos/restic-password
ExecStart=/usr/bin/node /usr/lib/sigmaos/apps/backup/dist/index.js run --kind daily
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /srv/nas /srv/backup
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=1G
CPUQuota=250%
TasksMax=256

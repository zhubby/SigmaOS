[Unit]
Description=SigmaOS scheduler tasks
Documentation=/usr/share/doc/sigmaos/README.md
After=local-fs.target
RequiresMountsFor=/srv/nas /srv/backup

[Service]
Type=oneshot
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
RuntimeDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/bin/node /usr/lib/sigmaos/apps/scheduler/dist/index.js --run-once
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos /srv/nas
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=150%
TasksMax=128

[Install]
WantedBy=multi-user.target

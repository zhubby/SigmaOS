[Unit]
Description=SigmaOS user terminal broker
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target systemd-tmpfiles-setup.service
Wants=local-fs.target

[Service]
Type=simple
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_TERMINAL_USER=sigmaos
Environment=SIGMAOS_TERMINAL_HELPER_SOCKET_PATH=/run/sigmaos/terminal-helper.sock
Environment=SIGMAOS_TERMINAL_SESSION_IDLE_TIMEOUT_MS=1800000
Environment=SIGMAOS_TERMINAL_MAX_SESSIONS=32
Environment=HOME=/var/lib/sigmaos-terminal
WorkingDirectory=/var/lib/sigmaos-terminal
KillMode=control-group
ExecStart=/usr/local/bin/node /usr/lib/sigmaos/apps/terminal-helper/dist/index.js
Restart=on-failure
RestartSec=3
UMask=0007
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/run/sigmaos /srv/nas /var/lib/sigmaos-terminal
InaccessiblePaths=/etc/sigmaos /var/lib/sigmaos /var/log/sigmaos
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target

[Unit]
Description=SigmaOS dedicated WebDAV server
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/srv/nas

[Service]
Type=exec
User=www-data
Group=www-data
RuntimeDirectory=sigmaos-webdav
RuntimeDirectoryMode=0700
ExecStart=/usr/sbin/apache2 -DFOREGROUND -f /etc/apache2/sites-available/sigmaos-webdav.conf
ExecReload=/usr/sbin/apache2 -k graceful -f /etc/apache2/sites-available/sigmaos-webdav.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/sigmaos-webdav /srv/nas
PrivateTmp=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

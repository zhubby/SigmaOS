[Unit]
Description=SigmaOS agent worker instance %i
Documentation=/usr/share/doc/sigmaos/README.md
After=sigmaos-api.service
Requires=sigmaos-api.service

[Service]
Type=simple
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
RuntimeDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/bin/node /usr/lib/sigmaos/apps/worker/dist/index.js
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos /srv/nas
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=768M
CPUQuota=200%
TasksMax=256

[Install]
WantedBy=multi-user.target

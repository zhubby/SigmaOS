[Unit]
Description=SigmaOS photo library worker
Documentation=file:///usr/share/doc/sigmaos/README.md
After=local-fs.target
RequiresMountsFor=/srv/nas

[Service]
Type=simple
User=sigmaos
Group=sigmaos
Environment=SIGMAOS_CONFIG=/etc/sigmaos/config.toml
WorkingDirectory=/var/lib/sigmaos
StateDirectory=sigmaos
LogsDirectory=sigmaos
ExecStart=/usr/local/bin/node /usr/lib/sigmaos/apps/photo-worker/dist/index.js
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sigmaos /var/log/sigmaos /srv/nas
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=1G
CPUQuota=250%
TasksMax=256

[Install]
WantedBy=multi-user.target
